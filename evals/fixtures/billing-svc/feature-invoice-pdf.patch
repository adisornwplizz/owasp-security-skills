+const express = require('express');
+const { exec } = require('child_process');
+const fs = require('fs/promises');
+const prisma = require('../prisma');
+const router = express.Router();
+
+// GET /invoices/:id/pdf?template=classic&logoUrl=https://...
+// Used by the customer portal and by the email service (which has no user token).
+router.get('/:id/pdf', async (req, res) => {
+  const invoice = await prisma.invoice.findUnique({ where: { id: req.params.id }, include: { customer: true } });
+  if (!invoice) return res.status(404).json({ error: 'not found' });
+
+  let logo = '';
+  if (req.query.logoUrl) {
+    const r = await fetch(req.query.logoUrl);
+    logo = Buffer.from(await r.arrayBuffer()).toString('base64');
+  }
+
+  const html = `<html><body><img src="data:image/png;base64,${logo}"><h1>Invoice ${invoice.number}</h1>
+    <p>${invoice.customer.name}</p><p>Total: ${invoice.total}</p></body></html>`;
+  const htmlPath = `/tmp/invoice-${invoice.id}.html`;
+  await fs.writeFile(htmlPath, html);
+
+  const template = req.query.template || 'classic';
+  exec(`wkhtmltopdf --title ${template} ${htmlPath} /tmp/invoice-${invoice.id}.pdf`, (err) => {
+    if (err) return res.status(500).json({ error: err.message });
+    res.sendFile(`/tmp/invoice-${invoice.id}.pdf`);
+  });
+});
+
+module.exports = router;
